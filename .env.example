# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ========================================================
# HOSTINGER SMTP CONFIGURATION FOR DELMOS CONTACT FORM
# ========================================================
# Configure these with your Hostinger Business Email credentials
# Hostinger standard SMTP host is: smtp.hostinger.com
# Port 465 uses SSL (secure: true) or port 587 uses STARTTLS (secure: false)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@delmostech.com"
SMTP_PASS="your_hostinger_email_password"

# The email address that will receive inquiries from the contact form
CONTACT_RECEIVER_EMAIL="alfaizkhan.tech@gmail.com"
